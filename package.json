{
  "name": "aio-proxy",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/agent-provider/*",
      "packages/plugins/*",
      "npm/*",
      "website"
    ],
    "catalog": {
      "ai": "7.0.8",
      "@ai-sdk/openai": "4.0.4",
      "@ai-sdk/anthropic": "4.0.3",
      "@ai-sdk/google": "4.0.3",
      "@ai-sdk/openai-compatible": "3.0.2",
      "@ai-sdk/mistral": "4.0.2",
      "@ai-sdk/groq": "4.0.2",
      "@ai-sdk/xai": "4.0.3",
      "@ai-sdk/provider": "4.0.1",
      "@anthropic-ai/sdk": "0.111.0",
      "@bufbuild/protobuf": "^2.10.2",
      "@google/genai": "2.11.0",
      "@opencode-ai/models": "0.0.11",
      "@openrouter/ai-sdk-provider": "2.10.0",
      "@rsbuild/plugin-tailwindcss": "^2.0.3",
      "@rslib/core": "^0.23.1",
      "@types/bun": "^1.3.14",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "class-variance-authority": "^0.7.1",
      "@inlang/paraglide-js": "2.22.0",
      "@lobehub/icons-static-svg": "1.93.0",
      "date-fns": "^4.4.0",
      "@date-fns/tz": "^1.5.0",
      "es-toolkit": "1.52.0",
      "lru-cache": "^11.5.2",
      "jose": "^6.2.3",
      "zod": "^4.5.4",
      "hono": "^4.13.3",
      "openai": "6.46.0",
      "drizzle-orm": "^0.45.2",
      "eventsource-parser": "^3.1.0",
      "@logtape/logtape": "2.2.4",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-day-picker": "^10.0.1",
      "react-dom": "^19.2.8",
      "recharts": "3.8.0",
      "tailwindcss": "^4.3.2",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run format:check",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware --type-check --ignore-pattern='**/*.test.ts' --ignore-pattern='**/*.test.tsx' --ignore-pattern='**/__tests__/**' --ignore-pattern='**/*test-support.ts' --ignore-pattern='**/test-support/**' --ignore-pattern='**/*.smoke.ts' .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:unit": "bun test ./install.test.ts && turbo run test:unit --filter=!@aio-proxy/website",
    "test:artifact": "turbo run test:artifact --filter=!@aio-proxy/website",
    "test:e2e:api": "turbo run e2e --filter=@aio-proxy/server --filter=@aio-proxy/cli",
    "test": "turbo run test test:artifact --filter=!@aio-proxy/website",
    "e2e": "turbo run e2e --filter=!@aio-proxy/website",
    "build:migrations": "bun run --filter @aio-proxy/core build:migrations",
    "i18n:compile": "bun run --filter @aio-proxy/i18n build",
    "build": "turbo run build --filter=!@aio-proxy/website",
    "build:dashboard": "turbo run build --filter=@aio-proxy/dashboard",
    "dev:prepare": "turbo run build --filter=@aio-proxy/core",
    "dev": "bun run dev:prepare && AIO_PROXY_PORT=22078 turbo run dev serve:dev --filter=!@aio-proxy/infra --filter=!@aio-proxy/website",
    "preflight": "bun run lint:types && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0-next.8",
    "@changesets/cli": "3.0.0-next.10",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@logtape/lint": "^2.2.4",
    "@microsoft/api-extractor": "7.58.11",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@rspress/core@2.0.19": "patches/@rspress%2Fcore@2.0.19.patch"
  }
}
