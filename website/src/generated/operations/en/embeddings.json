  "openapi": "3.1.0",
  "paths": {
    "/v1/embeddings": {
      "post": {
        "description": "Embeds input text. Numeric token inputs, dimensions and base64 encoding depend on the selected provider and conversion support.",
        "operationId": "createEmbedding",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "input": "Hello.",
                "model": "text-embedding-3-small"
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "examples": [
                  {
                    "input": "Hello.",
                    "model": "text-embedding-3-small"
                  }
                ],
                "properties": {
                  "dimensions": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "encoding_format": {
                    "enum": ["float", "base64"],
                    "type": "string"
                  },
                  "input": {
                    "anyOf": [
                      {
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 2048,
                        "minItems": 1,
                        "type": "array"
                      },
                      {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 2048,
                        "minItems": 1,
                        "type": "array"
                      },
                      {
                        "items": {
                          "items": {
                            "type": "number"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "maxItems": 2048,
                        "minItems": 1,
                        "type": "array"
                      }
                    ]
                  },
                  "model": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "user": {
                    "type": "string"
                  }
                },
                "required": ["model", "input"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "embedding": [0.1, 0.2],
                      "index": 0,
                      "object": "embedding"
                    }
                  ],
                  "model": "text-embedding-3-small",
                  "object": "list",
                  "usage": {
                    "prompt_tokens": 1,
                    "total_tokens": 1
                  }
                },
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "examples": [
                    {
                      "data": [
                        {
                          "embedding": [0.1, 0.2],
                          "index": 0,
                          "object": "embedding"
                        }
                      ],
                      "model": "text-embedding-3-small",
                      "object": "list",
                      "usage": {
                        "prompt_tokens": 1,
                        "total_tokens": 1
                      }
                    }
                  ],
                  "properties": {
                    "data": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "embedding": {
                            "anyOf": [
                              {
                                "items": {
                                  "type": "number"
                                },
                                "type": "array"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          },
                          "index": {
                            "type": "number"
                          },
                          "object": {
                            "const": "embedding",
                            "type": "string"
                          }
                        },
                        "required": ["object", "index", "embedding"],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "model": {
                      "type": "string"
                    },
                    "object": {
                      "const": "list",
                      "type": "string"
                    },
                    "usage": {
                      "additionalProperties": false,
                      "properties": {
                        "prompt_tokens": {
                          "type": "number"
                        },
                        "total_tokens": {
                          "type": "number"
                        }
                      },
                      "required": ["prompt_tokens", "total_tokens"],
                      "type": "object"
                    }
                  },
                  "required": ["object", "model", "data", "usage"],
                  "type": "object"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "Create embeddings",
        "tags": ["OpenAI-compatible"]
      }
    }
  },
