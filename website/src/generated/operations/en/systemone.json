  "openapi": "3.1.0",
  "paths": {
    "/v1/systemone": {
      "post": {
        "description": "Evaluates a nonempty question map against state. noul returns a numeric value, choice requires 1–255 criteria, and score requires 2–10 levels. Inputs must be JSON with finite numbers and at most 512 nesting levels; provider evaluation capability is required.",
        "operationId": "evaluateSystemOne",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "model": "systemone",
                "questions": {
                  "greeting": {
                    "instructions": "Is this a greeting?",
                    "type": "noul"
                  }
                },
                "state": "Hello."
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": {},
                "examples": [
                  {
                    "model": "systemone",
                    "questions": {
                      "greeting": {
                        "instructions": "Is this a greeting?",
                        "type": "noul"
                      }
                    },
                    "state": "Hello."
                  }
                ],
                "properties": {
                  "model": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "questions": {
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "additionalProperties": {},
                          "properties": {
                            "criteria": {
                              "additionalProperties": {},
                              "properties": {
                                "false": {
                                  "type": "string"
                                },
                                "true": {
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "instructions": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {},
                                  "type": "array"
                                },
                                {
                                  "additionalProperties": {},
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "type": "object"
                                }
                              ]
                            },
                            "type": {
                              "const": "noul",
                              "type": "string"
                            }
                          },
                          "required": ["type", "instructions"],
                          "type": "object"
                        },
                        {
                          "additionalProperties": {},
                          "properties": {
                            "criteria": {
                              "additionalProperties": {
                                "type": ["string", "null"]
                              },
                              "maxProperties": 255,
                              "minProperties": 1,
                              "propertyNames": {
                                "type": "string"
                              },
                              "type": "object"
                            },
                            "instructions": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {},
                                  "type": "array"
                                },
                                {
                                  "additionalProperties": {},
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "type": "object"
                                }
                              ]
                            },
                            "type": {
                              "const": "choice",
                              "type": "string"
                            }
                          },
                          "required": ["type", "instructions", "criteria"],
                          "type": "object"
                        },
                        {
                          "additionalProperties": {},
                          "properties": {
                            "criteria": {
                              "items": {
                                "type": "string"
                              },
                              "maxItems": 10,
                              "minItems": 2,
                              "type": "array"
                            },
                            "instructions": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "items": {},
                                  "type": "array"
                                },
                                {
                                  "additionalProperties": {},
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "type": "object"
                                }
                              ]
                            },
                            "type": {
                              "const": "score",
                              "type": "string"
                            }
                          },
                          "required": ["type", "instructions", "criteria"],
                          "type": "object"
                        }
                      ]
                    },
                    "minProperties": 1,
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "state": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {},
                        "type": "array"
                      },
                      {
                        "additionalProperties": {},
                        "propertyNames": {
                          "type": "string"
                        },
                        "type": "object"
                      }
                    ]
                  }
                },
                "required": ["model", "state", "questions"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "answers": {
                    "greeting": {
                      "noul": 0.9,
                      "type": "noul"
                    }
                  },
                  "model": "systemone"
