  "openapi": "3.1.0",
  "paths": {
    "/v1/live/{call_id}": {
      "get": {
        "description": "Upgrades a WebSocket connection to a caller-owned registered call. This is HTTP 101 signaling, not an ordinary JSON GET. The original provider/account is retained. Use a WebSocket client; this reference is read-only.",
        "operationId": "attachLiveCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. Subsequent messages are WebSocket frames, not an HTTP JSON response. Requires an eligible realtime provider."
          }
        },
        "summary": "Attach to a live call",
        "tags": ["Realtime"]
      }
    }
  },
  "security": [
