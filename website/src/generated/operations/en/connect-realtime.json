{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API Reference",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/realtime": {
      "get": {
        "description": "Upgrades a WebSocket connection. With call_id it attaches to that caller-owned call; otherwise it establishes a direct realtime connection using model and provider capability. Frames follow the chosen upstream realtime protocol, not SSE or JSON HTTP responses.",
        "operationId": "connectRealtime",
        "parameters": [
          {
            "in": "query",
            "name": "call_id",
            "required": false,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. Subsequent messages are WebSocket frames, not an HTTP JSON response. Requires an eligible realtime provider."
          }
        },
        "summary": "Connect realtime WebSocket",
        "tags": ["Realtime"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Realtime",
      "x-tag-id": "Realtime"
    }
  ]
}
