                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "description": "Upstream JSON object; fields depend on the selected provider. See the example and compatibility notes.",
                  "examples": [
                    {
                      "choices": [
                        {
                          "finish_reason": "stop",
                          "index": 0,
                          "logprobs": null,
                          "text": "Hello."
                        }
                      ],
                      "created": 0,
                      "id": "cmpl_example",
                      "model": "gpt-5",
                      "object": "text_completion"
                    }
                  ],
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "text/event-stream": {
                "example": "data: {\"id\":\"cmpl_example\",\"object\":\"text_completion\",\"created\":0,\"model\":\"gpt-5\",\"choices\":[{\"index\":0,\"text\":\"Hello.\",\"finish_reason\":\"stop\",\"logprobs\":null}]}\n\ndata: [DONE]\n\n",
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "examples": [
                    "data: {\"id\":\"cmpl_example\",\"object\":\"text_completion\",\"created\":0,\"model\":\"gpt-5\",\"choices\":[{\"index\":0,\"text\":\"Hello.\",\"finish_reason\":\"stop\",\"logprobs\":null}]}\n\ndata: [DONE]\n\n"
                  ],
                  "type": "string"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "Create a completion",
        "tags": ["OpenAI-compatible"]
      }
    }
  },
  "security": [
