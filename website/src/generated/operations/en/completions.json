  "openapi": "3.1.0",
  "paths": {
    "/v1/completions": {
      "post": {
        "description": "Generates legacy text completions. Set stream: true for SSE ending with data: [DONE]. Token-array prompts and provider-specific fields depend on the selected provider; conversion does not promise full upstream compatibility.",
        "operationId": "createCompletion",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "model": "gpt-5",
                "prompt": "Hello."
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": {},
                "examples": [
                  {
                    "model": "gpt-5",
                    "prompt": "Hello."
                  },
                  {
                    "model": "gpt-5",
                    "prompt": "Hello.",
                    "stream": true
                  }
                ],
                "properties": {
                  "best_of": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "conversation_id": {
                    "type": "string"
                  },
                  "echo": {
                    "type": ["boolean", "null"]
                  },
                  "frequency_penalty": {
                    "type": ["number", "null"]
                  },
                  "logit_bias": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "type": "number"
                        },
                        "propertyNames": {
                          "type": "string"
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "logprobs": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max_tokens": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "metadata": {
                    "additionalProperties": {},
                    "properties": {
                      "conversation_id": {
                        "type": "string"
                      },
                      "session_id": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "model": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "n": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "presence_penalty": {
                    "type": ["number", "null"]
                  },
                  "prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      },
                      {
                        "items": {
                          "items": {
                            "type": "number"
                          },
                          "type": "array"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prompt_cache_key": {
                    "type": ["string", "null"]
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "stop": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stream": {
                    "type": ["boolean", "null"]
                  },
                  "stream_options": {
                    "anyOf": [
                      {
                        "additionalProperties": {},
                        "properties": {
                          "include_obfuscation": {
                            "type": "boolean"
                          },
                          "include_usage": {
                            "type": "boolean"
                          }
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "suffix": {
                    "type": ["string", "null"]
                  },
                  "temperature": {
                    "type": ["number", "null"]
                  },
                  "top_p": {
                    "type": ["number", "null"]
                  },
                  "user": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["model"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "choices": [
                    {
                      "finish_reason": "stop",
                      "index": 0,
                      "logprobs": null,
                      "text": "Hello."
