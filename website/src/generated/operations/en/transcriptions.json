{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API Reference",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audio/transcriptions": {
      "post": {
        "description": "Uploads a multipart file for transcription; filenames in examples stand for uploaded bytes. Defaults to whisper-1. Conversion supports json, text and verbose_json (metadata required); srt, vtt and stream_format=sse require raw-provider support. A stream flag alone does not enable SSE.",
        "operationId": "transcribeAudio",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "example": {
                "file": "audio.wav",
                "model": "whisper-1"
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "examples": [
                  {
                    "file": "audio.wav",
                    "model": "whisper-1"
                  }
                ],
                "properties": {
                  "chunking_strategy": {
                    "type": ["string", "null"]
                  },
                  "file": {
                    "description": "Binary bytes, not a JSON string.",
                    "format": "binary",
                    "minLength": 1,
                    "type": "string"
                  },
                  "language": {
                    "type": ["string", "null"]
                  },
                  "model": {
                    "type": ["string", "null"]
                  },
                  "prompt": {
                    "type": ["string", "null"]
                  },
                  "response_format": {
                    "type": ["string", "null"]
                  },
                  "stream": {
                    "type": ["boolean", "null"]
                  },
                  "stream_format": {
                    "type": ["string", "null"]
                  },
                  "temperature": {
                    "type": ["number", "null"]
                  },
                  "timestamp_granularities": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": ["file"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "text": "Hello."
                },
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "examples": [
                    {
                      "text": "Hello."
                    }
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["text"],
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "SSE bytes forwarded from a compatible raw provider. Event names and payloads depend on that provider; no converted streaming implementation is available for this operation.",
                  "type": "string"
                }
              },
              "text/plain": {
                "example": "Hello.",
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "examples": ["Hello."],
                  "type": "string"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "Transcribe audio",
        "tags": ["OpenAI-compatible"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "OpenAI-compatible",
      "x-tag-id": "OpenAI"
    }
  ]
}
