  "info": {
    "title": "API Reference",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1beta/interactions": {
      "post": {
        "description": "Creates a Gemini interaction. Set stream: true for SSE. Converted streams use interaction.created, step events, interaction.completed, then event: done with data: [DONE]. Raw upstream streams retain their upstream format.",
        "operationId": "createInteraction",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "input": "Hello.",
                "model": "gemini-2.5-flash"
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "additionalProperties": {},
                "examples": [
                  {
                    "input": "Hello.",
                    "model": "gemini-2.5-flash"
                  },
                  {
                    "input": "Hello.",
                    "model": "gemini-2.5-flash",
                    "stream": true
                  }
                ],
                "properties": {
                  "agent": {
                    "type": "string"
                  },
                  "agent_config": {},
                  "background": {
                    "type": "boolean"
                  },
                  "environment": {},
                  "generation_config": {},
                  "input": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {},
                        "type": "array"
                      },
                      {
                        "additionalProperties": {},
                        "propertyNames": {
                          "type": "string"
                        },
                        "type": "object"
                      }
                    ]
                  },
                  "labels": {},
                  "model": {
                    "type": "string"
                  },
                  "previous_interaction_id": {
                    "type": "string"
                  },
                  "response_format": {},
                  "safety_settings": {},
                  "service_tier": {},
                  "store": {
                    "type": "boolean"
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "system_instruction": {
                    "type": "string"
                  },
                  "tools": {},
                  "webhook_config": {}
                },
                "required": ["input"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created": "1970-01-01T00:00:00.000Z",
                  "id": "intr_example",
                  "model": "gemini-2.5-flash",
                  "object": "interaction",
                  "status": "completed",
                  "steps": [
                    {
                      "content": [
                        {
                          "text": "Hello.",
                          "type": "text"
                        }
                      ],
                      "type": "model_output"
                    }
                  ],
                  "updated": "1970-01-01T00:00:00.000Z",
                  "usage": {
                    "total_cached_tokens": 0,
                    "total_input_tokens": 1,
                    "total_output_tokens": 1,
                    "total_thought_tokens": 0,
                    "total_tokens": 2,
                    "total_tool_use_tokens": 0
                  }
                },
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "description": "Upstream JSON object; fields depend on the selected provider. See the example and compatibility notes.",
                  "examples": [
                    {
                      "created": "1970-01-01T00:00:00.000Z",
                      "id": "intr_example",
                      "model": "gemini-2.5-flash",
                      "object": "interaction",
                      "status": "completed",
                      "steps": [
                        {
                          "content": [
                            {
                              "text": "Hello.",
                              "type": "text"
                            }
                          ],
                          "type": "model_output"
                        }
                      ],
                      "updated": "1970-01-01T00:00:00.000Z",
                      "usage": {
                        "total_cached_tokens": 0,
                        "total_input_tokens": 1,
                        "total_output_tokens": 1,
                        "total_thought_tokens": 0,
                        "total_tokens": 2,
                        "total_tool_use_tokens": 0
                      }
                    }
                  ],
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                }
              },
              "text/event-stream": {
                "example": "event: interaction.completed\ndata: {\"event_id\":\"evt_1\",\"event_type\":\"interaction.completed\",\"interaction\":{\"id\":\"intr_example\",\"object\":\"interaction\",\"model\":\"gemini-2.5-flash\",\"status\":\"completed\",\"created\":\"1970-01-01T00:00:00.000Z\",\"updated\":\"1970-01-01T00:00:00.000Z\",\"steps\":[{\"type\":\"model_output\",\"content\":[{\"type\":\"text\",\"text\":\"Hello.\"}]}],\"usage\":{\"total_input_tokens\":1,\"total_output_tokens\":1,\"total_tokens\":2,\"total_thought_tokens\":0,\"total_cached_tokens\":0,\"total_tool_use_tokens\":0}}}\n\nevent: done\ndata: [DONE]\n\n",
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "examples": [
                    "event: interaction.completed\ndata: {\"event_id\":\"evt_1\",\"event_type\":\"interaction.completed\",\"interaction\":{\"id\":\"intr_example\",\"object\":\"interaction\",\"model\":\"gemini-2.5-flash\",\"status\":\"completed\",\"created\":\"1970-01-01T00:00:00.000Z\",\"updated\":\"1970-01-01T00:00:00.000Z\",\"steps\":[{\"type\":\"model_output\",\"content\":[{\"type\":\"text\",\"text\":\"Hello.\"}]}],\"usage\":{\"total_input_tokens\":1,\"total_output_tokens\":1,\"total_tokens\":2,\"total_thought_tokens\":0,\"total_cached_tokens\":0,\"total_tool_use_tokens\":0}}}\n\nevent: done\ndata: [DONE]\n\n"
                  ],
                  "type": "string"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "Create an interaction",
        "tags": ["Gemini-compatible"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
