  "info": {
    "title": "API Reference",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/realtime/calls/{call_id}/hangup": {
      "post": {
        "description": "Hangs up a caller-owned registered call. After upstream success the proxy removes its call record, closes the attached socket, and returns 204 with no body.",
        "operationId": "hangupRealtimeCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Call removed and attached socket closed. No response body."
          }
        },
        "summary": "Hang up a realtime call",
        "tags": ["Realtime"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
