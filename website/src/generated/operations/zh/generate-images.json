{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API 参考",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/images/generations": {
      "post": {
        "description": "生成图片。未提供 model 时默认 gpt-image-2.5-sunburst。n 为 1–10（dall-e-3 仅 1）。流式与 URL 输出依赖兼容的原始上游，模型转换不支持流式。",
        "operationId": "generateImages",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "model": "gpt-image-2.5-sunburst",
                "n": 1,
                "prompt": "A red apple."
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "examples": [
                  {
                    "model": "gpt-image-2.5-sunburst",
                    "n": 1,
                    "prompt": "A red apple."
                  }
                ],
                "properties": {
                  "background": {
                    "type": ["string", "null"]
                  },
                  "model": {
                    "type": ["string", "null"]
                  },
                  "moderation": {
                    "type": ["string", "null"]
                  },
                  "n": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_compression": {
                    "type": ["number", "null"]
                  },
                  "output_format": {
                    "type": ["string", "null"]
                  },
                  "partial_images": {
                    "anyOf": [
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "quality": {
                    "type": ["string", "null"]
                  },
                  "response_format": {
                    "anyOf": [
                      {
                        "enum": ["url", "b64_json"],
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "size": {
                    "type": ["string", "null"]
                  },
                  "stream": {
                    "type": ["boolean", "null"]
                  },
                  "style": {
                    "type": ["string", "null"]
                  },
                  "user": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["prompt"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created": 0,
                  "data": [
                    {
                      "b64_json": "aW1hZ2U="
                    }
                  ]
                },
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "examples": [
                    {
                      "created": 0,
                      "data": [
                        {
                          "b64_json": "aW1hZ2U="
                        }
                      ]
                    }
                  ],
                  "properties": {
                    "created": {
                      "type": "number"
                    },
                    "data": {
                      "items": {
                        "additionalProperties": {},
                        "properties": {
                          "b64_json": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "usage": {
                      "additionalProperties": {},
                      "propertyNames": {
                        "type": "string"
                      },
                      "type": "object"
                    }
                  },
                  "required": ["created", "data"],
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "SSE bytes forwarded from a compatible raw provider. Event names and payloads depend on that provider; no converted streaming implementation is available for this operation.",
                  "type": "string"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "生成图片",
        "tags": ["OpenAI 兼容接口"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "OpenAI 兼容接口",
      "x-tag-id": "OpenAI"
    }
  ]
}
