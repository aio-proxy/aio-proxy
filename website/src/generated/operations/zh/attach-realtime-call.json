  "paths": {
    "/v1/realtime/calls/{call_id}": {
      "get": {
        "description": "升级为调用者拥有的已登记通话的 WebSocket 旁路，沿用原上游及账号。通话须仍存在于当前代理进程。普通 HTTP GET 不是 WebSocket 握手。",
        "operationId": "attachRealtimeCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. Subsequent messages are WebSocket frames, not an HTTP JSON response. Requires an eligible realtime provider."
          }
        },
        "summary": "连接实时通话",
        "tags": ["实时连接"]
      }
    }
  },
