{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API 参考",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/realtime/calls/{call_id}/hangup": {
      "post": {
        "description": "挂断调用者拥有的已登记通话。上游成功后代理移除通话记录、关闭关联连接，返回无正文的 204。",
        "operationId": "hangupRealtimeCall",
        "parameters": [
          {
            "in": "path",
            "name": "call_id",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Call removed and attached socket closed. No response body."
          }
        },
        "summary": "挂断实时通话",
        "tags": ["实时连接"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "实时连接",
      "x-tag-id": "Realtime"
    }
  ]
}
