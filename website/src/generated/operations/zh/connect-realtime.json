{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API 参考",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/realtime": {
      "get": {
        "description": "升级 WebSocket 连接。携带 call_id 时连接该调用者拥有的通话，否则根据 model 与上游能力建立直接实时连接。帧遵循所选上游实时协议，不是 SSE 或 JSON HTTP 响应。",
        "operationId": "connectRealtime",
        "parameters": [
          {
            "in": "query",
            "name": "call_id",
            "required": false,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. Subsequent messages are WebSocket frames, not an HTTP JSON response. Requires an eligible realtime provider."
          }
        },
        "summary": "连接实时 WebSocket",
        "tags": ["实时连接"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "实时连接",
      "x-tag-id": "Realtime"
    }
  ]
}
