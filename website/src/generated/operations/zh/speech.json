{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "API 参考",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "description": "返回音频二进制而非 JSON。model 缺失或空白时默认 tts-1。response_format 选择输出形式，列出的 MIME 类型并非上游全集。stream_format 需要兼容原始上游支持。",
        "operationId": "createSpeech",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "input": "Hello.",
                "model": "tts-1",
                "response_format": "mp3",
                "voice": "alloy"
              },
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "examples": [
                  {
                    "input": "Hello.",
                    "model": "tts-1",
                    "response_format": "mp3",
                    "voice": "alloy"
                  }
                ],
                "properties": {
                  "input": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": ["string", "null"]
                  },
                  "model": {
                    "type": ["string", "null"]
                  },
                  "response_format": {
                    "type": ["string", "null"]
                  },
                  "speed": {
                    "type": ["number", "null"]
                  },
                  "stream_format": {
                    "type": ["string", "null"]
                  },
                  "voice": {
                    "type": "string"
                  }
                },
                "required": ["input", "voice"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/*": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/aac": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/flac": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/mpeg": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/opus": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/pcm": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/wav": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "Binary bytes, not a JSON string.",
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "description": "SSE bytes forwarded from a compatible raw provider. Event names and payloads depend on that provider; no converted streaming implementation is available for this operation.",
                  "type": "string"
                }
              }
            },
            "description": "Successful response. Available representations depend on the request and upstream capability."
          }
        },
        "summary": "生成语音",
        "tags": ["OpenAI 兼容接口"]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
