{
  "name": "@aio-proxy/i18n",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./paraglide/*": {
      "types": "./src/paraglide/*.d.ts",
      "default": "./src/paraglide/*.js"
    }
  },
  "scripts": {
    "build": "paraglide-js compile --emit-ts-declarations && rslib build",
    "dev": "paraglide-js compile --emit-ts-declarations --watch",
    "test": "bun run test:unit",
    "test:unit": "cd ../.. && bun test packages/i18n/src/**/*.test.ts packages/i18n/__tests__/*.test.ts",
    "test:artifact": "cd ../.. && bun test ./packages/i18n/__tests__/*.smoke.ts"
  },
  "dependencies": {
    "@inlang/paraglide-js": "catalog:",
    "date-fns": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aio-proxy/infra": "workspace:*",
    "@inlang/plugin-message-format": "4.4.0",
    "@rslib/core": "catalog:",
    "typescript": "catalog:"
  }
}
