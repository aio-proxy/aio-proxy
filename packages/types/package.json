{
  "name": "@aio-proxy/types",
  "version": "0.16.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aio-proxy/aio-proxy.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.schema.json": "./dist/config.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch --no-clean",
    "test": "bun run test:unit",
    "test:unit": "bun test ./__tests__ ./src",
    "test:artifact": "bun test ./__tests__/build-entry.smoke.ts"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aio-proxy/infra": "workspace:*",
    "@rslib/core": "catalog:",
    "typescript": "catalog:"
  }
}
