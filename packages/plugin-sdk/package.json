{
  "name": "@aio-proxy/plugin-sdk",
  "version": "0.16.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aio-proxy/aio-proxy.git",
    "directory": "packages/plugin-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openai-stream": {
      "types": "./dist/openai-stream/index.d.ts",
      "default": "./dist/openai-stream/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch --no-clean",
    "test": "bun run test:unit && bun run test:types",
    "test:artifact": "bun test ./build/build-artifact.test.ts",
    "test:unit": "bun test ./src ./__tests__/localized-text.test.ts ./build/lobe-icon-keys.test.ts",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ai-sdk/provider": "catalog:",
    "@aio-proxy/shared": "workspace:*",
    "@aio-proxy/types": "workspace:*",
    "@date-fns/tz": "catalog:",
    "ai": "catalog:",
    "date-fns": "catalog:",
    "es-toolkit": "catalog:",
    "eventsource-parser": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aio-proxy/infra": "workspace:*",
    "@lobehub/icons-static-svg": "catalog:",
    "@rslib/core": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
